# Copy this file to .env and fill in your key(s)
#   cp .env.example .env
#
# You only need ONE key.
# - OpenAI:     https://platform.openai.com/api-keys
# - DeepSeek:   https://platform.deepseek.com/api_keys
# - OpenRouter: https://openrouter.ai/keys
# - Ollama:     no key needed, runs locally (see 00_Environment_Setup.ipynb)
#
# Then pick the matching provider at the top of any lesson notebook:
#   PROVIDER = 'openai' / 'deepseek' / 'openrouter' / 'ollama'

# OPENAI_API_KEY=sk-your-actual-key-here
# DEEPSEEK_API_KEY=sk-your-actual-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-actual-key-here
# OLLAMA_BASE_URL=http://localhost:11434/v1
